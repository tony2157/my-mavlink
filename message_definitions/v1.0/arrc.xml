      <entry value="2" name="ARRC_CC_FLAGS_GCS_SEEN"><description>GCS heartbeat received recently.</description></entry>
      <entry value="4" name="ARRC_CC_FLAGS_TIMESYNC_OK"><description>Clock mapped to the autopilot boot clock.</description></entry>
      <entry value="8" name="ARRC_CC_FLAGS_UTC_VALID"><description>UTC known (from SYSTEM_TIME).</description></entry>
      <entry value="16" name="ARRC_CC_FLAGS_DISK_OK"><description>Data disk above the reserve.</description></entry>
