    <message id="47002" name="ARRC_SDR_CONFIG">
      <description>SDR main configuration. Sent by the GCS with op=SET; echoed by the companion with op=APPLIED. TX shares the frequency, waveform and PRF.</description>
      <field type="uint64_t" name="freq_hz" units="Hz">Centre frequency.</field>
      <field type="uint32_t" name="sample_rate" units="Hz">Sample rate.</field>
      <field type="uint32_t" name="bandwidth" units="Hz">Analog bandwidth.</field>
      <field type="float" name="prf_hz" units="Hz">PRF (0 = waveform default).</field>
      <field type="uint32_t" name="num_pulses">TX pulses to send (0 = continuous).</field>
      <field type="float[2]" name="rx_gain_db" units="dB">RX gain per channel.</field>
      <field type="float[2]" name="tx_gain_db" units="dB">TX gain per channel.</field>
      <field type="uint16_t" name="req_id">Request id, echoed.</field>
