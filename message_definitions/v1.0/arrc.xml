  <messages>
    <message id="228" name="ARRC_SENSOR_RAW">
      <description>ARRC RF measurement downlink (autopilot to GCS). Latest power/phase from the onboard SDR.</description>
      <field type="uint32_t" name="time_boot_ms" units="ms">Autopilot time of sending.</field>
      <field type="uint64_t" name="time_usec" units="us">Sample time on the autopilot boot clock.</field>
      <field type="float" name="pwr_c" units="dBm">Co-pol power (NaN if unavailable).</field>
      <field type="float" name="pwr_x" units="dBm">Cross-pol power (NaN if unavailable).</field>
      <field type="float" name="phi_c" units="deg">Co-pol phase (see flags for the reference).</field>
      <field type="float" name="phi_x" units="deg">Cross-pol phase relative to co-pol (NaN if unavailable).</field>
      <extensions/>
      <field type="float" name="snr_db" units="dB">Co-pol SNR.</field>
      <field type="uint16_t" name="flags" enum="ARRC_MEAS_FLAGS" display="bitmask">Measurement flags.</field>
      <field type="uint16_t" name="n_avg">Pulses or samples averaged (saturates at 65535).</field>
    </message>
    <message id="47000" name="ARRC_CC_STATUS">
