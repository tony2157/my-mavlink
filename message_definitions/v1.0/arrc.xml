      <field type="uint32_t" name="time_boot_ms" units="ms">Companion uptime.</field>
      <field type="uint32_t" name="session_id">Data session id (links autopilot logs to the companion data folder).</field>
      <field type="uint32_t" name="disk_free_mb" units="MiB">Free space on the data disk.</field>
      <field type="uint32_t" name="dialect_hash">Hash of the MAVLink dialect the companion was built with.</field>
      <field type="uint32_t" name="timesync_rtt_us" units="us">Last TIMESYNC round trip time.</field>
      <field type="uint16_t" name="mem_used_mb" units="MiB">Memory used.</field>
      <field type="uint16_t" name="flags" enum="ARRC_CC_FLAGS" display="bitmask">Status flags.</field>
      <field type="uint8_t" name="state" enum="ARRC_CC_STATE">Mediator state.</field>
      <field type="uint8_t" name="cpu_load" units="%">CPU load.</field>
      <field type="int8_t" name="cpu_temp" units="degC">CPU temperature.</field>
      <field type="char[16]" name="sw_version">Companion software version.</field>
    </message>
