<?xml version="1.0"?>
<mavlink>
  <!-- ARRC RFSonde dialect: companion computer (onboard SDR) <-> autopilot <-> GCS.
       Included from ardupilotmega.xml. Message ids 47000-47019 and MAV_CMD ids 47000-47009 are reserved for ARRC.
       The companion computer is MAV_COMP_ID_ONBOARD_COMPUTER (191). -->
  <dialect>2</dialect>
  <enums>
    <enum name="ARRC_CC_STATE">
      <description>Companion computer mediator state.</description>
      <entry value="0" name="ARRC_CC_STATE_BOOT"/>
      <entry value="1" name="ARRC_CC_STATE_IDLE"/>
      <entry value="2" name="ARRC_CC_STATE_ACTIVE"/>
      <entry value="3" name="ARRC_CC_STATE_ERROR"/>
      <entry value="4" name="ARRC_CC_STATE_SHUTTING_DOWN"/>
